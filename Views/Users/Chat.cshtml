@model IEnumerable<TelegramAdminPanel.Models.BotMessage>
@{
    var user = ViewBag.User as TelegramAdminPanel.Models.BotUser;
    ViewData["Title"] = $"Chat with {user?.FirstName}";
}

<div class="row mb-4 align-items-center">
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-circle p-2" style="border-color: var(--border-color);">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
    </div>
    <div class="col">
        <h2 class="fw-bold mb-0">@user?.FirstName @user?.LastName</h2>
        <p class="text-muted mb-0">@@@user?.Username | ID: @user?.ChatId</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6 mx-auto">
        <div class="premium-card p-0 d-flex flex-column" style="height: 600px;">
            <!-- Chat Header -->
            <div class="p-3 border-bottom" style="background: var(--bg-card);">
                <div class="d-flex align-items-center">
                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-weight: bold;">
                        @((user?.FirstName?.FirstOrDefault() ?? user?.Username?.FirstOrDefault() ?? '?').ToString().ToUpper())
                    </div>
                    <div class="fw-semibold">Conversation History</div>
                </div>
            </div>

            <!-- Chat Messages -->
            <div class="flex-grow-1 p-4 chat-container" id="chatContainer">
                @if (!Model.Any())
                {
                    <div class="text-center text-muted mt-5">
                        <p>No messages in this conversation yet.</p>
                    </div>
                }
                
                @foreach (var msg in Model)
                {
                    <div class="chat-bubble @(msg.IsFromBot ? "bot" : "user")">
                        <div>@msg.Text</div>
                        <span class="chat-time text-end">@msg.Timestamp.ToString("MMM dd, HH:mm")</span>
                    </div>
                }
            </div>

            <!-- Chat Input -->
            <div class="p-3 border-top" style="background: var(--bg-card);">
                <!-- Media Preview Area -->
                <div id="mediaPreviewContainer" class="mb-2 d-none" style="position: relative; max-width: 200px; max-height: 200px;">
                    <button type="button" class="btn-close" id="clearMediaBtn" style="position: absolute; top: -10px; right: -10px; background-color: var(--bg-card); z-index: 10; padding: 4px; border-radius: 50%; border: 1px solid var(--border-color);" aria-label="Close"></button>
                    <div id="previewContent" style="border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color);"></div>
                </div>

                <form asp-action="SendMessage" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="chatId" value="@user?.ChatId" />
                    
                    <label class="btn btn-outline-secondary rounded-circle p-2 mb-0 d-flex align-items-center justify-content-center" style="cursor: pointer; width: 40px; height: 40px; border-color: var(--border-color);" title="Attach File">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                        <input type="file" name="mediaFile" id="mediaFile" accept="image/*,video/*,audio/*" class="d-none" />
                    </label>

                    <!-- Record Voice Button -->
                    <button type="button" id="recordBtn" class="btn btn-outline-secondary rounded-circle p-2 mb-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-color: var(--border-color);" title="Record Voice">
                        <svg id="micIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                    </button>
                    
                    <span id="recordTimer" class="d-none ms-2 me-2 fw-bold text-danger" style="min-width: 45px;">00:00</span>

                    <input type="text" name="text" id="messageText" class="form-control rounded-pill px-4" placeholder="Type a message to send via Bot..." autocomplete="off" />
                    
                    <button type="submit" class="btn btn-primary rounded-pill px-4 d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                        Send
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto scroll to bottom
        var container = document.getElementById("chatContainer");
        if (container) {
            container.scrollTop = container.scrollHeight;
        }

        // Media Preview Logic
        const mediaInput = document.getElementById('mediaFile');
        const mediaPreviewContainer = document.getElementById('mediaPreviewContainer');
        const previewContent = document.getElementById('previewContent');
        const clearMediaBtn = document.getElementById('clearMediaBtn');
        const messageText = document.getElementById('messageText');

        mediaInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                let element = '';

                if (file.type.startsWith('image/')) {
                    element = `<img src="${url}" style="max-width: 100%; max-height: 200px; display: block;" />`;
                } else if (file.type.startsWith('video/')) {
                    element = `<video src="${url}" controls style="max-width: 100%; max-height: 200px; display: block;"></video>`;
                } else if (file.type.startsWith('audio/')) {
                    element = `<audio src="${url}" controls style="width: 100%; display: block; margin-top: 80px;"></audio>`;
                } else {
                    element = `<div class="p-3 bg-secondary text-white text-center" style="height: 100px; display: flex; align-items: center; justify-content: center;">File selected: ${file.name}</div>`;
                }

                previewContent.innerHTML = element;
                mediaPreviewContainer.classList.remove('d-none');
                messageText.required = false; // text is no longer required if file is attached
            } else {
                clearPreview();
            }
        });

        clearMediaBtn.addEventListener('click', function() {
            mediaInput.value = '';
            clearPreview();
        });

        function clearPreview() {
            previewContent.innerHTML = '';
            mediaPreviewContainer.classList.add('d-none');
            messageText.required = true;
        }

        // Initialize required state
        if (!mediaInput.files || mediaInput.files.length === 0) {
            messageText.required = true;
        }

        // Voice Recording Logic
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;
        let recordInterval;
        let recordSeconds = 0;

        const recordBtn = document.getElementById('recordBtn');
        const recordTimer = document.getElementById('recordTimer');
        const micIcon = document.getElementById('micIcon');

        recordBtn.addEventListener('click', async function() {
            if (!isRecording) {
                // Start Recording
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.addEventListener("dataavailable", event => {
                        audioChunks.push(event.data);
                    });

                    mediaRecorder.addEventListener("stop", () => {
                        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        
                        // Create File from Blob and put it in the file input
                        const audioFile = new File([audioBlob], "voice_message.webm", { type: "audio/webm", lastModified: new Date().getTime() });
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(audioFile);
                        mediaInput.files = dataTransfer.files;
                        
                        // Trigger change event to show preview
                        const event = new Event('change');
                        mediaInput.dispatchEvent(event);

                        // Stop all tracks to release mic
                        stream.getTracks().forEach(track => track.stop());
                    });

                    mediaRecorder.start();
                    isRecording = true;
                    
                    // UI changes
                    recordBtn.classList.add('record-pulse');
                    micIcon.innerHTML = '<rect x="6" y="6" width="12" height="12" rx="2" ry="2"></rect>'; // Stop icon
                    recordTimer.classList.remove('d-none');
                    messageText.disabled = true;
                    messageText.placeholder = "Recording...";

                    // Timer
                    recordSeconds = 0;
                    recordTimer.innerText = "00:00";
                    recordInterval = setInterval(() => {
                        recordSeconds++;
                        const mins = String(Math.floor(recordSeconds / 60)).padStart(2, '0');
                        const secs = String(recordSeconds % 60).padStart(2, '0');
                        recordTimer.innerText = `${mins}:${secs}`;
                    }, 1000);

                } catch (err) {
                    alert("Could not access microphone: " + err);
                }
            } else {
                // Stop Recording
                mediaRecorder.stop();
                isRecording = false;
                
                // UI changes
                recordBtn.classList.remove('record-pulse');
                micIcon.innerHTML = '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/>';
                recordTimer.classList.add('d-none');
                clearInterval(recordInterval);
                messageText.disabled = false;
                messageText.placeholder = "Type a message to send via Bot...";
            }
        });
    </script>
}
