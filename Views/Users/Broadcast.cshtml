@{
    ViewData["Title"] = "Broadcast Message";
}

<div class="row mb-4 align-items-center">
    <div class="col-auto pe-0">
        <a asp-action="Index" class="btn btn-outline-light" style="padding: 8px; border: none; background: transparent;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </a>
    </div>
    <div class="col">
        <h2 class="mb-0">Broadcast Message</h2>
        <p class="text-muted mb-0" style="font-size: 0.875rem;">Send a message to all users who have interacted with your bot.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="premium-card">
            
            <div style="background-color: #fcf4d6; border-left: 3px solid #f1c21b; padding: 16px; margin-bottom: 32px; display: flex; align-items: flex-start; color: #161616;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f1c21b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-3 mt-1 flex-shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <div>
                    <strong style="font-size: 0.875rem; display: block; margin-bottom: 4px;">Warning</strong>
                    <span style="font-size: 0.875rem;">This will send a message to ALL registered users. Please double check your message before sending to avoid spamming your users.</span>
                </div>
            </div>

            <form asp-action="SendBroadcast" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                
                <div class="mb-4">
                    <label class="form-label">Attach Media (Optional)</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="file" name="mediaFile" id="mediaFile" accept="image/*,video/*,audio/*" class="form-control" />
                        
                        <!-- Record Voice Button -->
                        <button type="button" id="recordBtn" class="btn btn-outline-danger d-flex align-items-center justify-content-center" style="min-width: 45px; height: 38px;" title="Record Voice">
                            <svg id="micIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                        </button>
                        <span id="recordTimer" class="d-none fw-bold text-danger" style="min-width: 45px;">00:00</span>
                    </div>
                    <div class="form-text mt-1">You can attach an image, video, or audio file, or record a voice note to broadcast.</div>
                </div>

                <!-- Media Preview Area -->
                <div id="mediaPreviewContainer" class="mb-4 d-none" style="position: relative; max-width: 100%; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); padding: 10px; background: var(--bg-main);">
                    <button type="button" class="btn-close" id="clearMediaBtn" style="position: absolute; top: 10px; right: 10px; z-index: 10; background-color: var(--bg-card); padding: 6px; border-radius: 50%;" aria-label="Close"></button>
                    <div id="previewContent" class="text-center"></div>
                </div>

                <div class="mb-5">
                    <label for="text" class="form-label">Message Content</label>
                    <textarea class="form-control" id="messageText" name="text" rows="6" placeholder="Write your announcement or broadcast message here..."></textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary" style="padding-right: 64px; position: relative;" onclick="return confirm('Are you absolutely sure you want to broadcast this message to ALL users?');">
                        Send to Everyone
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%);"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const mediaInput = document.getElementById('mediaFile');
        const mediaPreviewContainer = document.getElementById('mediaPreviewContainer');
        const previewContent = document.getElementById('previewContent');
        const clearMediaBtn = document.getElementById('clearMediaBtn');
        const messageText = document.getElementById('messageText');

        mediaInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const url = URL.createObjectURL(file);
                let element = '';

                if (file.type.startsWith('image/')) {
                    element = `<img src="${url}" style="max-width: 100%; max-height: 300px; display: inline-block; border-radius: 4px;" />`;
                } else if (file.type.startsWith('video/')) {
                    element = `<video src="${url}" controls style="max-width: 100%; max-height: 300px; display: inline-block; border-radius: 4px;"></video>`;
                } else if (file.type.startsWith('audio/')) {
                    element = `<audio src="${url}" controls style="width: 100%; display: inline-block;"></audio>`;
                } else {
                    element = `<div class="p-3 bg-secondary text-white text-center rounded">File selected: ${file.name}</div>`;
                }

                previewContent.innerHTML = element;
                mediaPreviewContainer.classList.remove('d-none');
                messageText.required = false; 
            } else {
                clearPreview();
            }
        });

        clearMediaBtn.addEventListener('click', function() {
            mediaInput.value = '';
            clearPreview();
        });

        function clearPreview() {
            previewContent.innerHTML = '';
            mediaPreviewContainer.classList.add('d-none');
            messageText.required = true;
        }

        // Initialize required state
        if (!mediaInput.files || mediaInput.files.length === 0) {
            messageText.required = true;
        }

        // Voice Recording Logic
        let mediaRecorder;
        let audioChunks = [];
        let isRecording = false;
        let recordInterval;
        let recordSeconds = 0;

        const recordBtn = document.getElementById('recordBtn');
        const recordTimer = document.getElementById('recordTimer');
        const micIcon = document.getElementById('micIcon');

        recordBtn.addEventListener('click', async function() {
            if (!isRecording) {
                // Start Recording
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    mediaRecorder = new MediaRecorder(stream);
                    audioChunks = [];

                    mediaRecorder.addEventListener("dataavailable", event => {
                        audioChunks.push(event.data);
                    });

                    mediaRecorder.addEventListener("stop", () => {
                        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
                        
                        // Create File from Blob and put it in the file input
                        const audioFile = new File([audioBlob], "broadcast_voice.webm", { type: "audio/webm", lastModified: new Date().getTime() });
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(audioFile);
                        mediaInput.files = dataTransfer.files;
                        
                        // Trigger change event to show preview
                        const event = new Event('change');
                        mediaInput.dispatchEvent(event);

                        // Stop all tracks to release mic
                        stream.getTracks().forEach(track => track.stop());
                    });

                    mediaRecorder.start();
                    isRecording = true;
                    
                    // UI changes
                    recordBtn.classList.add('record-pulse');
                    micIcon.innerHTML = '<rect x="6" y="6" width="12" height="12" rx="2" ry="2"></rect>'; // Stop icon
                    recordTimer.classList.remove('d-none');
                    messageText.disabled = true;
                    messageText.placeholder = "Recording broadcast message...";

                    // Timer
                    recordSeconds = 0;
                    recordTimer.innerText = "00:00";
                    recordInterval = setInterval(() => {
                        recordSeconds++;
                        const mins = String(Math.floor(recordSeconds / 60)).padStart(2, '0');
                        const secs = String(recordSeconds % 60).padStart(2, '0');
                        recordTimer.innerText = `${mins}:${secs}`;
                    }, 1000);

                } catch (err) {
                    alert("Could not access microphone: " + err);
                }
            } else {
                // Stop Recording
                mediaRecorder.stop();
                isRecording = false;
                
                // UI changes
                recordBtn.classList.remove('record-pulse');
                micIcon.innerHTML = '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/>';
                recordTimer.classList.add('d-none');
                clearInterval(recordInterval);
                messageText.disabled = false;
                messageText.placeholder = "Write your announcement or broadcast message here...";
            }
        });
    </script>
}
