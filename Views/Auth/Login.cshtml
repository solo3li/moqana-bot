@{
    ViewData["Title"] = "Login";
    Layout = null; // No sidebar for login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bot Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--bg-main);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        .login-card {
            background: var(--bg-card);
            border: 1px solid rgba(226, 230, 237, 0.6);
            border-radius: 24px;
            padding: 48px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08);
        }
        .login-logo {
            color: var(--accent);
            margin-bottom: 24px;
        }
        h2 {
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }
        p {
            color: var(--text-muted);
            margin-bottom: 32px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="login-logo"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
            <h2>Welcome Back</h2>
            <p>Please enter your details to sign in.</p>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="border-radius: 12px; font-size: 0.95rem; font-weight: 500;">
                @ViewData["ErrorMessage"]
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div class="mb-3">
                <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.9rem;">Username</label>
                <input type="text" name="username" class="form-control" required autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.9rem;">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-3" style="font-size: 1rem;">Sign In</button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
